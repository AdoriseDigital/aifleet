# 2. XML Sitemaps & Dynamic Header Compression
/sitemap.xml
  Cache-Control: public, max-age=3600, s-maxage=3600, stale-while-revalidate=1800
  Content-Type: application/xml; charset=utf-8
  X-Robots-Tag: noindex, follow
  Vary: Accept-Encoding
  Cache-Tag: sitemaps

/sitemaps/*
  Cache-Control: public, max-age=3600, s-maxage=3600, stale-while-revalidate=1800
  Content-Type: application/xml; charset=utf-8
  X-Robots-Tag: noindex, follow
  Vary: Accept-Encoding
  Cache-Tag: sitemaps

# 3. Crawler Governance Directives & IndexNow Key
/robots.txt
  Cache-Control: public, max-age=3600, s-maxage=3600
  Content-Type: text/plain; charset=utf-8
  Cache-Tag: robots

/adorise-indexnow-key-2026.txt
  Cache-Control: public, max-age=86400, s-maxage=86400
  Content-Type: text/plain; charset=utf-8
  Cache-Tag: indexnow

/llms.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *

/llms-full.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *

# 4. Global Static Assets — 1-Year Immutable Edge Cache
/*.css
  Cache-Control: public, max-age=31536000, immutable
  Vary: Accept-Encoding

/*.js
  Cache-Control: public, max-age=31536000, immutable
  Vary: Accept-Encoding

/*.svg
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/svg+xml

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable
