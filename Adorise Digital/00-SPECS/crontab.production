# ==============================================================================
# Adorise Digital Autonomous Growth, Outreach & Social Crontab
# Host: Netcup Sovereign VPS (185.194.142.32)
# Timezone: UTC
# ==============================================================================

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

# ------------------------------------------------------------------------------
# 1. SCOUT / SOCIAL RADAR: High-Intent Lead Discovery (Temperature: 0.0)
# Scrapes commercial complaint signals from Reddit, X, and search engines.
# ------------------------------------------------------------------------------
00 08 * * * cd /opt/adorise/scout && /usr/bin/python3 K_social_radar.py >> /var/log/adorise_radar.log 2>&1

# ------------------------------------------------------------------------------
# 2. DETERMINISTIC LEAD SANITIZER & FIREWALL (Zero AI / Pure Code)
# Strips @reddit.com & webuser@* fake emails, routes Reddit/X to Social DMs,
# and outputs verified B2B emails to verified_email_leads.json.
# ------------------------------------------------------------------------------
30 08 * * * cd /opt/adorise/scout && /usr/bin/python3 sanitize_and_verify_leads.py >> /var/log/adorise_sanitizer.log 2>&1

# ------------------------------------------------------------------------------
# 3. VERIFIED OUTREACH DISPATCHER: Brevo / Resend Delivery (Temperature: 0.0)
# Dispatches authenticated emails via info@ai.goadorisedigital.com.
# Logs exact messageId strings; halts on zero verified leads.
# ------------------------------------------------------------------------------
00 09 * * * cd /opt/adorise/scout && /usr/bin/python3 K_email_sender.py >> /var/log/adorise_outreach.log 2>&1

# ------------------------------------------------------------------------------
# 4. SOCIAL MEDIA SCHEDULER: Omni-Channel Publishing (Temperature: 0.3)
# Publishes to connected Composio / Postiz channels across 3 daily slots.
# ------------------------------------------------------------------------------
30 08 * * * cd /opt/mega-stack/social-scheduler && /usr/bin/node scheduler.js Morning >> /var/log/adorise_social.log 2>&1
00 13 * * * cd /opt/mega-stack/social-scheduler && /usr/bin/node scheduler.js Midday >> /var/log/adorise_social.log 2>&1
30 18 * * * cd /opt/mega-stack/social-scheduler && /usr/bin/node scheduler.js Evening >> /var/log/adorise_social.log 2>&1

# ------------------------------------------------------------------------------
# 5. DAILY PIPELINE AUDIT & EXECUTIVE BRIEFING
# Compiles verified sent counts, quarantine stats, and social reach.
# ------------------------------------------------------------------------------
00 20 * * * cd /opt/adorise/scout && /usr/bin/python3 K_analytics_reporter.py >> /var/log/adorise_audit.log 2>&1
